---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/field-notes/</loc>
  </url>
  {% for note in collections.fieldNotes %}
  <url>
    <loc>{{ site.url }}{{ note.page.url }}</loc>
    <lastmod>{{ note.date | htmlDateString }}</lastmod>
  </url>
  {% endfor %}
</urlset>
