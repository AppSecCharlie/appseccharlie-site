---
layout: layouts/base.njk
containerClass: notes-container
ogType: article
---
<main>
    <article class="field-note">
        <header>
            <h1>{{ title }}</h1>
            <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
        </header>
        <div class="note-body">
            {{ content | safe }}
        </div>
        <footer>
            <a href="/field-notes/">Back to Field Notes</a>
        </footer>
    </article>
</main>
